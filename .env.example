# Copy to .env.local and fill in. NEVER commit a filled version. (CLAUDE.md §3.8)

# ── Supabase ────────────────────────────────────────────────────
# Anon key is safe in the mobile app ONLY because RLS is correct.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role BYPASSES RLS ENTIRELY.
# Backend only. Never in a client, never in an Edge Function users can reach,
# never in a build environment. Rotate immediately if exposed.
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments ────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Storage: Cloudflare R2 (zero egress — do not swap for S3) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=provia-evidence

# ── Messaging ───────────────────────────────────────────────────
# SMS is for ACCOUNT VERIFICATION ONLY. Handoff codes display in-app.
TERMII_API_KEY=
RESEND_API_KEY=

# ── Maps: navigation only. Distance/matching runs in PostGIS. ───
MAPBOX_ACCESS_TOKEN=

# ── Observability ───────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=
